#include <stdio.h>

void showRoom()
{
    printf("\n");
    printf("==================================================\n");
    printf("                 IDENTITY ROOM\n");
    printf("==================================================\n");
    printf("\n");
    printf("             +----------------------+\n");
    printf("             |      IDENTITY        |\n");
    printf("             |       ROOM            |\n");
    printf("             +----------------------+\n");
    printf("\n");
    printf("       [1] FAMILY PHOTO\n");
    printf("       [2] FAVORITE SONG\n");
    printf("       [3] HOMETOWN\n");
    printf("       [4] IMPORTANT EVENT\n");
    printf("       [5] DAILY MEMORY\n");
    printf("       [6] EXIT ROOM\n");
    printf("\n");
    printf("==================================================\n");
}

int main()
{
    char name[50];
    char family[50];
    char song[50];
    char hometown[50];
    char event[100];
    char daily[100];

    int choice;
    int discovered = 0;

    printf("==================================================\n");
    printf("              WELCOME TO IDENTITY ROOM\n");
    printf("==================================================\n");

    printf("\nEnter your name: ");
    scanf(" %[^\n]", name);

    printf("\nHello, %s!\n", name);
    printf("Let's create your personal Identity Room.\n");

    printf("\nEnter a family member's name: ");
    scanf(" %[^\n]", family);

    printf("Enter your favorite song: ");
    scanf(" %[^\n]", song);

    printf("Enter your hometown: ");
    scanf(" %[^\n]", hometown);

    printf("Enter an important event or memory: ");
    scanf(" %[^\n]", event);

    printf("Enter something you usually do every day: ");
    scanf(" %[^\n]", daily);

    printf("\nYour Identity Room is ready!\n");

    do
    {
        showRoom();

        printf("Choose an object: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("\n------------- FAMILY PHOTO -------------\n");
                printf("Family member: %s\n", family);
                printf("\nMemory Prompt:\n");
                printf("Think about a happy moment you shared with %s.\n",
                       family);
                printf("-----------------------------------------\n");
                discovered++;
                break;

            case 2:
                printf("\n------------- FAVORITE SONG ------------\n");
                printf("Favorite song: %s\n", song);
                printf("\nMemory Prompt:\n");
                printf("Where or when do you usually listen to this song?\n");
                printf("-----------------------------------------\n");
                discovered++;
                break;

            case 3:
                printf("\n--------------- HOMETOWN ----------------\n");
                printf("Hometown: %s\n", hometown);
                printf("\nMemory Prompt:\n");
                printf("Think about a familiar place in %s.\n",
                       hometown);
                printf("------------------------------------------\n");
                discovered++;
                break;

            case 4:
                printf("\n----------- IMPORTANT EVENT --------------\n");
                printf("Your memory: %s\n", event);
                printf("\nMemory Prompt:\n");
                printf("What makes this event important to you?\n");
                printf("------------------------------------------\n");
                discovered++;
                break;

            case 5:
                printf("\n------------- DAILY MEMORY --------------\n");
                printf("Daily activity: %s\n", daily);
                printf("\nMemory Prompt:\n");
                printf("When do you usually do this activity?\n");
                printf("-----------------------------------------\n");
                discovered++;
                break;

            case 6:
                printf("\n==================================================\n");
                printf("                 LEAVING ROOM\n");
                printf("==================================================\n");

                printf("\n%s, you explored %d memory objects.\n",
                       name, discovered);

                printf("Thank you for visiting your Identity Room!\n");
                printf("Have a wonderful day.\n");

                break;

            default:
                printf("\nInvalid choice. Please choose 1-6.\n");
        }

    } while(choice != 6);

    return 0;
}